  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Передайте JWT токен авторизації у заголовку Authorization"
      },
      "CSRFToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "CSRF токен для захисту від підробки запитів (отримується при handshake)"
      }
    },
    "schemas": {
      "StandardSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Операцію успішно виконано"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Опис причини збою"
          }
        }
      },
      "ProjectSummary": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Farm_Main"
          },
          "updatedAt": {
            "type": "number",
            "example": 1727738400000
          },
          "nodeCount": {
            "type": "integer",
            "example": 18
          }
        }
      },
      "ProjectOverviewItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Farm_Main"
          },
          "createdAt": {
            "type": "number",
            "example": 1727652000000
          },
          "updatedAt": {
            "type": "number",
            "example": 1727738400000
          },
          "status": {
            "type": "string",
            "example": "idle"
          },
          "lastRunTime": {
            "type": "number",
            "example": 1727730000000
          }
        }
      },
      "ProjectSettings": {
        "type": "object",
        "properties": {
          "browserResolution": {
            "type": "string",
            "example": "1280x720"
          },
          "proxy": {
            "type": "string",
            "example": "http://user:pass@proxy.example.com:8080"
          },
          "maxActionDelay": {
            "type": "integer",
            "example": 1500
          },
          "autoRestartOnCrash": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ProjectDetailResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "Farm_Main"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "globalVariables": {
                "type": "object"
              }
            }
          }
        }
      },
      "GraphSaveData": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "globalVariables": {
                "type": "object"
              }
            }
          }
        }
      },
      "InventoryItem": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "example": "Sunflower.png"
          },
          "number": {
            "type": "number",
            "example": 150
          },
          "selector": {
            "type": "string",
            "example": "div[data-testid=\"item-Sunflower\"]"
          }
        }
      },
      "GlobalStatsData": {
        "type": "object",
        "properties": {
          "totalRuns": {
            "type": "integer",
            "example": 142
          },
          "totalHarvests": {
            "type": "integer",
            "example": 2540
          },
          "uptimeHours": {
            "type": "number",
            "example": 48.5
          }
        }
      },
      "SystemStatusResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "memory": {
                "type": "object",
                "properties": {
                  "rss": {
                    "type": "string",
                    "example": "145 MB"
                  },
                  "heapUsed": {
                    "type": "string",
                    "example": "85 MB"
                  }
                }
              },
              "activeBrowsers": {
                "type": "integer",
                "example": 2
              },
              "uptimeSeconds": {
                "type": "number",
                "example": 14200
              }
            }
          }
        }
      },
      "ErrorMetricsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "totalErrors": {
                "type": "integer",
                "example": 7
              },
              "byType": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "example": {
                  "BrowserError": 3,
                  "ValidationError": 4
                }
              },
              "recentErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "CacheMetricsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer",
                "example": 24
              },
              "hits": {
                "type": "integer",
                "example": 1204
              },
              "misses": {
                "type": "integer",
                "example": 48
              },
              "hitRate": {
                "type": "string",
                "example": "96.17%"
              }
            }
          }
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Недійсний або відсутній JWT токен",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": "Необхідна авторизація"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Запитуваний ресурс не знайдено",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": "Проект не знайдено"
            }
          }
        }
      }
    }
  }
}