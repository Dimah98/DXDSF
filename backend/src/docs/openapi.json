        "security": [
          {
            "BearerAuth": []
          },
          {
            "CSRFToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectNames"
                ],
                "properties": {
                  "projectNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
