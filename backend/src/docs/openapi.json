{
  "openapi": "3.0.3",
  "info": {
    "title": "Sunflower Land Bot Constructor REST API",
    "description": "Вичерпна специфікація REST API серверного рушія Sunflower Land Bot Constructor.\nЗабезпечує керування проектами, сесіями браузера Camoufox (антидетект Firefox),\nінвентарем ферми, статистикою та системними метриками.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Команда підтримки Sunflower Land Bot"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Локальний сервер розробки"
    },
    {
      "url": "http://192.168.0.107:3001",
      "description": "Локальна мережа (CasaOS / Home Server)"
    },
    {
      "url": "https://dxd.pp.ua",
      "description": "Продакшн сервер з SSL"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Перевірка працездатності сервера (Health Check)",
        "description": "Публічний ендпоінт для Docker healthcheck та систем моніторингу. Не вимагає авторизації.",
        "tags": [
          "Системні"
        ],
        "responses": {
          "200": {
            "description": "Сервер працює стабільно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "uptime": {
                      "type": "number",
                      "example": 3600.45
                    },
                    "timestamp": {
                      "type": "number",
                      "example": 1727738400000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "summary": "Детальний статус сервера",
        "description": "Повертає інформацію про використання пам'яті (RSS, Heap), версії та активні браузерні сесії.",
        "tags": [
          "Системні"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успішне отримання статусу",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/api/system/error-metrics": {
      "get": {
        "summary": "Метрики помилок та збоїв",
        "description": "Повертає статистику помилок (ErrorMetrics), згруповану за типами та останні зафіксовані збої.",
        "tags": [
          "Системні"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Метрики помилок",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/cache-metrics": {
      "get": {
        "summary": "Метрики LRU кешу",
        "description": "Статистика In-Memory CacheService (hits, misses, розмір, коефіцієнт ефективності).",
        "tags": [
          "Системні"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Статистика кешу",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheMetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/apm-metrics": {
      "get": {
        "summary": "Зведений звіт APM продуктивності",
        "description": "Затримки (p50, p95, p99), активні транзакції, пам'ять, CPU, лаги Event Loop та RUM.",
        "tags": [
          "APM та Моніторинг"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Метрики APM",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/system/traces": {
      "get": {
        "summary": "Останні транзакції та спани",
        "description": "Повертає список останніх виконаних запитів із розбивкою на спани (Waterfall / Flamegraph).",
        "tags": [
          "APM та Моніторинг"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список транзакцій",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/slow-queries": {
      "get": {
        "summary": "Список повільних SQL запитів",
        "description": "Запити до SQLite бази даних, що виконувалися довше 20 мс.",
        "tags": [
          "APM та Моніторинг"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Повільні запити",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/traces/otlp": {
      "get": {
        "summary": "Експорт трас OpenTelemetry (OTLP JSON)",
        "description": "Формує OpenTelemetry-сумісний потік трас для Jaeger, Zipkin, Tempo або Datadog.",
        "tags": [
          "APM та Моніторинг"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OTLP ResourceSpans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/rum": {
      "post": {
        "summary": "Збереження RUM метрик з браузера клієнта",
        "description": "Прийом Web Vitals (FCP, LCP, TTFB) та помилок JavaScript.",
        "tags": [
          "APM та Моніторинг"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Метрики прийнято"
          }
        }
      },
      "get": {
        "summary": "Зведена статистика Real User Monitoring",
        "description": "Отримання усереднених показників завантаження інтерфейсу користувачами.",
        "tags": [
          "APM та Моніторинг"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Статистика RUM",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/restart": {
      "post": {
        "summary": "Плавне перезавантаження бекенду",
        "description": "Ініціює graceful shutdown з flushing логів та перезапуском через менеджер процесів.",
        "tags": [
          "Системні"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CSRFToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Перезавантаження ініційовано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardSuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "summary": "Отримати список усіх проектів",
        "description": "Повертає список проектів із базовими метаданими. Результат кешується в CacheService.",
        "tags": [
          "Проекти"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Список проектів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectSummary"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/overview": {
      "get": {
        "summary": "Розширений огляд проектів",
        "description": "Отримує повний огляд усіх проектів з датами модифікації, налаштуваннями та розмірами.",
        "tags": [
          "Проекти"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Огляд проектів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectOverviewItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/status": {
      "get": {
        "summary": "Поточні статуси виконання проектів",
        "description": "Повертає статус для кожного проекту (чи запущений бот, чи активний браузер).",
        "tags": [
          "Проекти"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Статуси проектів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "idle",
                              "running",
                              "error"
                            ],
                            "example": "running"
                          },
                          "browserOpen": {
                            "type": "boolean",
                            "example": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{name}": {
      "get": {
        "summary": "Отримати деталі конкретного проекту",
        "description": "Повертає повні дані проекту включно з вузлами, з'єднаннями та змінними.",
        "tags": [
          "Проекти"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Назва проекту",
            "schema": {
              "type": "string",
              "example": "Farm_Main"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Деталі проекту",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "delete": {
        "summary": "Видалити проект",
        "description": "Видаляє проект, історію його запусків та збережені файли.",
        "tags": [
          "Проекти"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CSRFToken": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Проект успішно видалено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardSuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{name}/settings": {
      "get": {
        "summary": "Отримати налаштування проекту",
        "description": "Повертає конфігурацію браузера (розширення, проксі, тайм-аути) та параметри запуску.",
        "tags": [
          "Проекти"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Налаштування проекту",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ProjectSettings"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Оновити налаштування проекту",
        "description": "Зберігає нові налаштування браузера або параметри виконання.",
        "tags": [
          "Проекти"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CSRFToken": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Налаштування успішно збережено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardSuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/load": {
      "get": {
        "summary": "Завантажити структуру графа проекту",
        "description": "Завантажує nodes, edges та змінні проекту для редактора React Flow.",
        "tags": [
          "Графи та Збереження"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Farm_Main"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Граф успішно завантажено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphSaveData"
                }
              }
            }
          }
        }
      }
    },
    "/api/save": {
      "post": {
        "summary": "Зберегти граф сценарію",
        "description": "Зберігає поточний стан графа в SQLite та синхронізує з JSON файлом.",
        "tags": [
          "Графи та Збереження"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CSRFToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectName",
                  "nodes",
                  "edges"
                ],
                "properties": {
                  "projectName": {
                    "type": "string",
                    "example": "Farm_Main"
                  },
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "globalVariables": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Проект успішно збережено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardSuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/run-multiple": {
      "post": {
        "summary": "Пакетний запуск списку проектів",
        "description": "Запускає паралельне або чергове виконання декількох вибраних ферм згідно з лімітами семафора.",
        "tags": [
          "Масове керування"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CSRFToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectNames"
                ],
                "properties": {
                  "projectNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "Farm_1",
                      "Farm_2"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Запуск ініційовано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardSuccessResponse"
                }
              }
            }
          }
        }
      }
    },
