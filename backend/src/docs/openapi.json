    "/api/browser/status/{projectName}": {
      "get": {
        "summary": "Статус браузера проекту",
        "description": "Перевіряє, чи активне вікно браузера та CDP сесія для проекту.",
        "tags": [
          "Браузер Camoufox"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectName",
            "in": "path",
