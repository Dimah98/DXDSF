    {
      "name": "Get Inventory - Path Traversal Attempt",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 (validation blocks path traversal)\", function () {",
              "    // Note: Express may return 404 at routing level before validation runs",
              "    // This is acceptable as it still blocks the attack",
              "    pm.expect([400, 404]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Response indicates invalid project name\", function () {",
              "    // Note: 404 response is HTML, which is fine - attack is blocked at routing level",
              "    if (pm.response.code === 400) {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('error');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
