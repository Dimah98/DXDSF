              "    pm.expect(jsonData.data).to.have.lengthOf(0);",
              "});",
              "",
              "pm.test(\"Timestamp is null for nonexistent inventory\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.timestamp).to.be.null;",
              "});"
