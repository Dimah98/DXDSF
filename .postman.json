    {
      "name": "Get Inventory Overview - All Accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has required top-level fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('accounts');",
              "    pm.expect(jsonData).to.have.property('resources');",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData).to.have.property('timestamp');",
              "});",
              "",
              "pm.test(\"Accounts field is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.accounts).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Resources field is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.resources).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Data field is an object\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "});",
              "",
              "pm.test(\"Timestamp is a valid ISO string\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.timestamp).to.be.a('string');",
              "    var date = new Date(jsonData.timestamp);",
              "    pm.expect(date.toString()).to.not.equal('Invalid Date');",
              "});",
              "",
              "pm.test(\"Data structure is valid (if accounts exist)\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.accounts.length > 0) {",
              "        var firstAccount = jsonData.accounts[0];",
              "        pm.expect(jsonData.data).to.have.property(firstAccount);",
              "        pm.expect(jsonData.data[firstAccount]).to.be.an('object');",
              "    }",
              "});",
              "",
              "pm.test(\"Resource counts are numbers (if data exists)\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.accounts.length > 0 && jsonData.resources.length > 0) {",
              "        var firstAccount = jsonData.accounts[0];",
              "        var firstResource = jsonData.resources[0];",
              "        if (jsonData.data[firstAccount] && jsonData.data[firstAccount][firstResource] !== undefined) {",
              "            pm.expect(jsonData.data[firstAccount][firstResource]).to.be.a('number');",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
