        "url": {
          "raw": "{{baseUrl}}/api/inventory/../../../etc/passwd",
          "host": ["{{baseUrl}}"],
          "path": ["api", "inventory", "..", "..", "..", "etc", "passwd"]
        },
        "description": "Test security: attempt path traversal attack. Should be blocked by input validation."
      },
      "response": []
    },
