{
  "info": {
    "_postman_id": "sf-bot-api-collection-v1",
    "name": "Sunflower Land Bot Constructor API",
    "description": "Повна офіційна колекція Postman для тестування REST API платформи Sunflower Land Bot Constructor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "JWT_TOKEN",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "CSRF_TOKEN",
      "value": "sf_csrf_token_dev",
      "type": "string"
    },
    {
      "key": "PROJECT_NAME",
      "value": "Farm_Main",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{JWT_TOKEN}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.add({ key: 'x-csrf-token', value: pm.collectionVariables.get('CSRF_TOKEN') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Системні ендпоінти",
      "item": [
        {
          "name": "Health Check (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/health",
              "host": ["{{BASE_URL}}"],
              "path": ["health"]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Детальний статус сервера",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/system/status",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "system", "status"]
            }
          }
        },
        {
          "name": "Метрики помилок (ErrorMetrics)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/system/error-metrics",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "system", "error-metrics"]
            }
          }
        },
        {
          "name": "Метрики кешу (CacheMetrics)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/system/cache-metrics",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "system", "cache-metrics"]
            }
          }
        },
        {
          "name": "Перезавантаження сервера",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{BASE_URL}}/api/system/restart",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "system", "restart"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Керування Проектами",
      "item": [
        {
          "name": "Список усіх проектів",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/projects",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "Розширений огляд проектів",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/projects/overview",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "overview"]
            }
          }
        },
        {
          "name": "Поточні статуси виконання",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/projects/status",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "status"]
            }
          }
        },
        {
          "name": "Деталі проекту",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/projects/{{PROJECT_NAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "{{PROJECT_NAME}}"]
            }
          }
        },
        {
          "name": "Отримати налаштування проекту",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/projects/{{PROJECT_NAME}}/settings",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "{{PROJECT_NAME}}", "settings"]
            }
          }
        },
        {
          "name": "Оновити налаштування проекту",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"browserResolution\": \"1280x720\",\n  \"maxActionDelay\": 1000,\n  \"autoRestartOnCrash\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/projects/{{PROJECT_NAME}}/settings",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "{{PROJECT_NAME}}", "settings"]
            }
          }
        },
        {
          "name": "Видалити проект",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{BASE_URL}}/api/projects/{{PROJECT_NAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "{{PROJECT_NAME}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Завантаження та Збереження Графа",
      "item": [
        {
          "name": "Завантажити граф проекту",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/load?name={{PROJECT_NAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "load"],
              "query": [
                {
                  "key": "name",
                  "value": "{{PROJECT_NAME}}"
                }
              ]
            }
          }
        },
        {
          "name": "Зберегти граф проекту",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"{{PROJECT_NAME}}\",\n  \"nodes\": [\n    {\n      \"id\": \"start-1\",\n      \"type\": \"startNode\",\n      \"position\": { \"x\": 100, \"y\": 100 },\n      \"data\": {}\n    }\n  ],\n  \"edges\": [],\n  \"globalVariables\": {}\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/save",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "save"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Керування Браузером Camoufox",
      "item": [
        {
          "name": "Перевірити середовище браузера",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/browser-env",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "browser-env"]
            }
          }
        },
        {
          "name": "Відкрити браузер для проекту",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{BASE_URL}}/api/browser/open/{{PROJECT_NAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "browser", "open", "{{PROJECT_NAME}}"]
            }
          }
        },
        {
          "name": "Закрити браузер проекту",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{BASE_URL}}/api/browser/close/{{PROJECT_NAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "browser", "close", "{{PROJECT_NAME}}"]
            }
          }
        },
        {
          "name": "Статус сесії браузера",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/browser/status/{{PROJECT_NAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "browser", "status", "{{PROJECT_NAME}}"]
            }
          }
        },
        {
          "name": "Список доступних профілів",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/browser/profiles",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "browser", "profiles"]
            }
          }
        },
        {
          "name": "Список проксі-серверів",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/browser/proxies",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "browser", "proxies"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Масовий Запуск та Пакетні Дії",
      "item": [
        {
          "name": "Пакетний запуск вибраних проектів",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNames\": [\"Farm_1\", \"Farm_2\"]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/projects/run-multiple",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "run-multiple"]
            }
          }
        },
        {
          "name": "Пакетна зупинка проектів",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectNames\": [\"Farm_1\", \"Farm_2\"]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/projects/stop-multiple",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "projects", "stop-multiple"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Інвентар та Статистика",
      "item": [
        {
          "name": "Зведений інвентар усіх ферм",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/all-inventories",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "all-inventories"]
            }
          }
        },
        {
          "name": "Огляд інвентарю за категоріями",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/inventory/overview",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "inventory", "overview"]
            }
          }
        },
        {
          "name": "Інвентар конкретного проекту",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/inventory/{{PROJECT_NAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "inventory", "{{PROJECT_NAME}}"]
            }
          }
        },
        {
          "name": "Глобальна статистика фермерства",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/global-stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "global-stats"]
            }
          }
        }
      ]
    }
  ]
}
